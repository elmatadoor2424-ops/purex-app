# WapiPilot WhatsApp Webhook API URL
# Format: https://api.wapipilot.com/v1/webhook/<your_channel>
WAPIPILOT_WEBHOOK_URL=https://api.wapipilot.com/v1/webhook/purex

# Optional Bearer Token / API Key for WapiPilot
WAPIPILOT_API_KEY=your_wapipilot_api_key_here

# Admin Operations Passcode (Default: purex2026 or donia)
ADMIN_PASSCODE=purex2026
